rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, update, delete: if false;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.role == 'user'
        && request.resource.data.createdAt == request.time;
    }

    function validSlug(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 120
        && value.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }

    function validOptionalUrl(value) {
      return value == null || value == ''
        || (value is string && value.size() <= 2048 && value.matches('^https?://.*'));
    }

    function validProject(data) {
      return data.keys().hasOnly([
          'title', 'slug', 'clientId', 'category', 'description', 'thumbnail',
          'thumbnailAlt', 'gallery', 'videoUrl', 'technologies', 'technologyIcons',
          'completionDate', 'websiteUrl', 'androidUrl', 'iosUrl',
          'githubUrl', 'caseStudyUrl', 'businessChallenge', 'solution',
          'keyFeatures', 'results', 'featured', 'published', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && validSlug(data.slug)
        && data.category is string && data.category.size() <= 80
        && data.description is string && data.description.size() <= 2000
        && data.technologies is list && data.technologies.size() <= 30
        && data.technologyIcons is map && data.technologyIcons.size() <= 30
        && data.gallery is list && data.gallery.size() <= 30
        && data.featured is bool && data.published is bool
        && validOptionalUrl(data.thumbnail)
        && validOptionalUrl(data.videoUrl)
        && validOptionalUrl(data.websiteUrl)
        && validOptionalUrl(data.androidUrl)
        && validOptionalUrl(data.iosUrl)
        && validOptionalUrl(data.githubUrl)
        && validOptionalUrl(data.caseStudyUrl);
    }

    function validClient(data) {
      return data.keys().hasOnly([
          'name', 'slug', 'logo', 'logoStoragePath', 'industry', 'description',
          'websiteUrl', 'androidUrl', 'iosUrl', 'projectIds', 'published',
          'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 160
        && validSlug(data.slug)
        && data.industry is string && data.industry.size() <= 120
        && data.description is string && data.description.size() <= 2000
        && data.projectIds is list && data.projectIds.size() <= 100
        && data.published is bool
        && validOptionalUrl(data.logo)
        && validOptionalUrl(data.websiteUrl)
        && validOptionalUrl(data.androidUrl)
        && validOptionalUrl(data.iosUrl);
    }

    function validService(data) {
      return data.keys().hasOnly([
          'title', 'slug', 'description', 'icon', 'featured', 'displayOrder',
          'published', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && validSlug(data.slug)
        && data.description is string && data.description.size() <= 2000
        && data.icon is string && data.icon.size() <= 60
        && data.featured is bool && data.published is bool
        && data.displayOrder is int && data.displayOrder >= 0;
    }

    function validTestimonial(data) {
      return data.keys().hasOnly([
          'quote', 'name', 'role', 'company', 'photo', 'published',
          'createdAt', 'updatedAt'
        ])
        && data.quote is string && data.quote.size() > 0 && data.quote.size() <= 2000
        && data.name is string && data.name.size() > 0 && data.name.size() <= 160
        && data.role is string && data.role.size() <= 160
        && data.company is string && data.company.size() <= 160
        && data.published is bool
        && validOptionalUrl(data.photo);
    }

    match /projects/{projectId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create: if isAdmin() && validProject(request.resource.data);
      allow update: if isAdmin() && validProject(request.resource.data);
      allow delete: if isAdmin();
    }

    match /clients/{clientId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create: if isAdmin() && validClient(request.resource.data);
      allow update: if isAdmin() && validClient(request.resource.data);
      allow delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update: if isAdmin() && validService(request.resource.data);
      allow delete: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update: if isAdmin() && validTestimonial(request.resource.data);
      allow delete: if isAdmin();
    }

    match /enquiries/{enquiryId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    match /serviceBookings/{bookingId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'user'
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'serviceId', 'serviceTitle', 'details',
          'referenceUrl', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.serviceId is string && request.resource.data.serviceId.size() <= 120
        && request.resource.data.serviceTitle is string && request.resource.data.serviceTitle.size() > 0 && request.resource.data.serviceTitle.size() <= 160
        && request.resource.data.details is string && request.resource.data.details.size() >= 10 && request.resource.data.details.size() <= 3000
        && request.resource.data.referenceUrl is string && request.resource.data.referenceUrl.size() <= 2048
        && validOptionalUrl(request.resource.data.referenceUrl)
        && request.resource.data.status == 'Requested'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['Requested', 'In Review', 'Scheduled', 'Completed', 'Cancelled']
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /rateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /settings/{settingId} {
      allow read: if settingId in ['site', 'about'];
      allow write: if isAdmin() && (settingId != 'about' || (
        request.resource.data.keys().hasOnly([
          'title', 'intro', 'storyTitle', 'story', 'imageUrl', 'imageAlt', 'videoUrl',
          'technologies', 'technologyIcons', 'published', 'updatedAt'
        ])
        && request.resource.data.title is string && request.resource.data.title.size() <= 180
        && request.resource.data.intro is string && request.resource.data.intro.size() <= 1000
        && request.resource.data.storyTitle is string && request.resource.data.storyTitle.size() <= 100
        && request.resource.data.story is string && request.resource.data.story.size() <= 4000
        && validOptionalUrl(request.resource.data.imageUrl)
        && request.resource.data.imageAlt is string && request.resource.data.imageAlt.size() <= 180
        && validOptionalUrl(request.resource.data.videoUrl)
        && request.resource.data.technologies is list && request.resource.data.technologies.size() <= 40
        && request.resource.data.technologyIcons is map && request.resource.data.technologyIcons.size() <= 40
        && request.resource.data.published is bool
        && request.resource.data.updatedAt == request.time
      ));
    }
  }
}
