rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.admin == true
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
    }

    match /content/{ownerUid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.auth.uid == ownerUid
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
      allow delete: if isAdmin() && request.auth.uid == ownerUid;
    }

    match /booking-attachments/{ownerUid}/{bookingId}/{fileName} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == ownerUid);
      allow create, update: if request.auth != null
        && request.auth.uid == ownerUid
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'user'
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('(image/(jpeg|png|webp|avif)|application/pdf)');
      allow delete: if (request.auth != null && request.auth.uid == ownerUid)
        || isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
